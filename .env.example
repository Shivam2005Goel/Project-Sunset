# Aftercare configuration. Copy to .env and set what you need.
#
# The local path needs NOTHING set. `python tasks.py seed` runs the whole agent loop with
# no cloud project, no API key, and no network - see README section 3. Set GEMINI_API_KEY
# only if you want a real model doing the reasoning instead of the offline planner.

# --- local ---------------------------------------------------------------------------

# Optional. Without it, packages/core/offline.py handles every task deterministically and
# labels its output `offline-deterministic` everywhere it surfaces.
# GEMINI_API_KEY=

# local (default) | cloud
AFTERCARE_MODE=local

# Where local state lives. Delete this directory to reset; `python tasks.py clean` does it.
# AFTERCARE_DATA_DIR=.aftercare

# --- cloud ---------------------------------------------------------------------------

# PROJECT_ID=
# REGION=us-central1

# --- models --------------------------------------------------------------------------

# MODEL_FAST handles ~95% of calls. MODEL_DEEP is used only for closure-packet synthesis.
# MODEL_FAST=gemini-3.5-flash
# MODEL_DEEP=gemini-3.5-pro

# --- adapters ------------------------------------------------------------------------
#
# Each names either the managed component or its fallback. In local mode the fallback is
# always used regardless of what is set here, so a local run can never reach a Google
# endpoint by accident.
#
# RUNTIME_ADAPTER=agent_runtime        # or cloud_run_jobs
# MEMORY_ADAPTER=memory_bank           # or firestore_vector
# REGISTRY_ADAPTER=agent_registry      # or gcs_versioned
# GUARDRAIL_ADAPTER=model_armor        # or dlp_plus_classifier

# --- demo ----------------------------------------------------------------------------

# Cosmetic: the speed shown on the dashboard clock during the time-warp.
# TIMEWARP_FACTOR=400

# Where escalations and drafts are addressed. Fictional by default.
# EXECUTOR_EMAIL=executor@example.invalid

# --- the boundary --------------------------------------------------------------------
#
# AUTO_SEND exists so the safety boundary is explicit and testable. It is hard-wired to
# false in packages/core/config.py and setting it here changes nothing - which is exactly
# what tests/test_policy.py::test_environment_cannot_turn_auto_send_on asserts.
AUTO_SEND=false
